# ─────────────────────────────────────────────────────────────────
#  PaisaGrow Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=generate-a-50-char-random-string-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app,localhost
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
DATABASE_URL=postgresql://user:pass@host:5432/railway
FRONTEND_URL=https://your-app.vercel.app

# ── Gmail SMTP (for password-reset emails) ────────────────────────
# Step-by-step setup for Gmail:
#
#  1. Go to your Google Account → Security → 2-Step Verification (enable it)
#  2. Search for "App passwords" in Google Account settings
#  3. Create a new App Password:  App = "Mail"  Device = "Other (PaisaGrow)"
#  4. Google gives you a 16-character code — paste it as EMAIL_HOST_PASSWORD
#     (do NOT use your regular Gmail password — it won't work)
#
# Note: If you use Google Workspace (paid) you may need to enable
# "Less secure app access" or use OAuth2 instead of App Passwords.
#
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=PaisaGrow <your@gmail.com>

# ── Google OAuth ──────────────────────────────────────────────────
# Enables "Continue with Google" on the login and sign-up pages.
#
#  1. Go to https://console.cloud.google.com/apis/credentials
#  2. Click "Create Credentials" → "OAuth 2.0 Client ID"
#  3. Application type: Web application
#  4. Authorised JavaScript origins:
#       https://your-app.vercel.app   (production)
#       http://localhost:3000         (local dev)
#  5. Copy the Client ID (ends in .apps.googleusercontent.com)
#
# Note: Also add REACT_APP_GOOGLE_CLIENT_ID to your frontend .env
#
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
